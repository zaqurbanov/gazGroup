# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/caspian_gaz

# Admin session secret (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-64-hex-chars

# Public site URL (canonical, sitemap, Open Graph, Telegram admin button)
SITE_URL=https://example.com

# First admin, created by `npm run seed`. Change before going live.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Telegram notifications for new orders / inquiries. Leave empty to disable.
# 1) Create a bot with @BotFather and copy the token.
# 2) Add the bot to your chat or group (as admin for channels), send a message there,
#    then open https://api.telegram.org/bot<TOKEN>/getUpdates to read "chat":{"id":...}.
# 3) Every person who should get a private message must open the bot and press /start first.
TELEGRAM_BOT_TOKEN=
# One or more recipients, comma separated: people, groups or channels.
# Add ":<topicId>" to target a topic in a forum group. Example:
#   TELEGRAM_CHAT_ID=123456789,987654321,-1001234567890,-1001234567890:5
TELEGRAM_CHAT_ID=
